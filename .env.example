# ────────────────────────────────────────────────────────────────────────────
# Data Tiger — Environment Configuration
# Copy to `.env` and fill in your values.
# ────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Local (Docker): postgresql+asyncpg://datapilot:datapilot@localhost:5432/datapilot
# Supabase:       postgresql+asyncpg://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql+asyncpg://datapilot:datapilot@localhost:5432/datapilot

# ── Redis ───────────────────────────────────────────────────────────────────
# Local (Docker): redis://localhost:6379/0
# Upstash (prod):  rediss://default:[PASSWORD]@[HOST]:6379
REDIS_URL=redis://localhost:6379/0

# ── File Storage (S3-compatible) ────────────────────────────────────────────
# Local (MinIO):  http://localhost:9000
# Supabase S3:    https://[PROJECT_REF].supabase.co/storage/v1/s3
# Cloudflare R2:  https://[ACCOUNT_ID].r2.cloudflarestorage.com
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=datapilot

# ── Supabase (optional — provides auth + DB + storage) ─────────────────────
# Get these from: https://supabase.com/dashboard/project/[REF]/settings/api
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Clerk Auth (optional — alternative to Supabase Auth) ────────────────────
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...

# ── Anthropic AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API.
# Local dev:    http://localhost:5174
# Vercel prod:  https://datatiger.vercel.app
CORS_ORIGINS=http://localhost:5174

# ── Frontend API URL (production only) ─────────────────────────────────────
# Set this in Vercel environment variables to point at your deployed API.
# Leave blank for local dev (Vite proxy handles it).
# Example: https://api.datatiger.com  or  https://your-api.fly.dev
VITE_API_URL=

# ── Deployment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Stripe (Phase 4) ───────────────────────────────────────────────────────
# STRIPE_PAYMENT_LINK_PRO=https://buy.stripe.com/...
