# ────────────────────────────────────────────────────────────────────────────
# DataPilot — Environment Configuration
# Copy to `.env` and fill in your values.
# ────────────────────────────────────────────────────────────────────────────

# ── Database ────────────────────────────────────────────────────────────────
# Local (Docker): postgresql+asyncpg://datapilot:datapilot@localhost:5432/datapilot
# Managed (prod): your provider's asyncpg connection string
DATABASE_URL=postgresql+asyncpg://datapilot:datapilot@localhost:5432/datapilot

# ── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File Storage (S3-compatible) ────────────────────────────────────────────
# Local (MinIO):  http://localhost:9000
# Cloudflare R2:  https://[ACCOUNT_ID].r2.cloudflarestorage.com
R2_ENDPOINT_URL=http://localhost:9000
R2_ACCESS_KEY_ID=minioadmin
R2_SECRET_ACCESS_KEY=minioadmin
R2_BUCKET_NAME=datapilot

# ── Anthropic AI ────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Optional per-stage model overrides (defaults are sensible):
# CLEANING_MODEL=claude-opus-5
# VERIFICATION_MODEL=claude-opus-5
# MANIPULATION_MODEL=claude-opus-5
# ANALYSIS_MODEL=claude-sonnet-5          # set to claude-opus-5 for depth over latency
# DICTIONARY_MODEL=claude-haiku-4-5-20251001

# How model calls are dispatched.
#   api — Anthropic SDK, billed to ANTHROPIC_API_KEY above. The production path.
#   cli — subprocess the local `claude` binary; usage bills the operator's
#         Claude subscription instead. CLOSED TESTING ONLY — it drives one
#         person's personal subscription, so it cannot serve real users, and
#         the app refuses to boot in production with it set.
# LLM_BACKEND=api
# CLAUDE_CLI_PATH=claude
# CLAUDE_CLI_TIMEOUT_SECONDS=300

# ── Auth (Clerk) ────────────────────────────────────────────────────────────
# Local dev can skip Clerk entirely (DEV_AUTH_BYPASS=true below).
# Production REQUIRES these and DEV_AUTH_BYPASS=false.
CLERK_SECRET_KEY=sk_test_...
CLERK_PUBLISHABLE_KEY=pk_test_...
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...          # frontend (build-time)
# Clerk Frontend API URL / JWT issuer — session tokens are verified against
# {issuer}/.well-known/jwks.json
CLERK_JWT_ISSUER=https://your-app.clerk.accounts.dev
# Svix signing secret for Clerk user-sync webhooks (starts with whsec_)
CLERK_WEBHOOK_SECRET=whsec_...
# true (non-production only) → requests resolve to a local dev user with no
# token. Ignored in production, which always requires a valid Clerk JWT.
DEV_AUTH_BYPASS=true

# ── Uploads ─────────────────────────────────────────────────────────────────
# Reject files larger than this many bytes (default 50 MB).
MAX_UPLOAD_BYTES=52428800

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated origins allowed to call the API.
# Local dev:   http://localhost:5174
# Vercel prod: https://datapilot.app  (your deployed frontend origin)
CORS_ORIGINS=http://localhost:5174

# ── Frontend API URL (production only) ──────────────────────────────────────
# Set in Vercel env to point at the deployed API. Leave blank for local dev
# (the Vite proxy handles it). Must match the connect-src origin in vercel.json.
# Example: https://api.datapilot.app  or  https://your-api.up.railway.app
VITE_API_URL=

# ── Deployment ──────────────────────────────────────────────────────────────
# development | staging | production  (production enforces auth + secret checks)
ENVIRONMENT=development
